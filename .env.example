NODE_ENV=development
HOST=127.0.0.1
PORT=3210
PROJECT_CONFIG_DIR=../config/projects

# GitHub webhook HMAC secret. Use a long random secret in production.
GITHUB_WEBHOOK_SECRET=replace-with-at-least-16-characters

# Jenkins controller API connection.
JENKINS_BASE_URL=http://127.0.0.1:8080
JENKINS_JOB_NAME=central-cicd-build
JENKINS_USER=central-cicd-api
JENKINS_API_TOKEN=replace-me
# Optional Jenkins remote build token in addition to Basic auth.
JENKINS_TRIGGER_TOKEN=replace-with-long-random-token

# Deploy worker. Keep execution disabled until reviewed dry-run tests pass.
DEPLOY_EXECUTION_ENABLED=false
DEPLOY_WORKER_TOKEN=replace-with-long-random-token
DEPLOY_ARTIFACT_STAGING_ROOT=/opt/cicd/artifacts
DEPLOY_WORK_ROOT=/opt/cicd/work
DATABASE_URL=postgres://central_cicd:replace-me@127.0.0.1:5432/central_cicd
