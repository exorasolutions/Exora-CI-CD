class TargetLock:
    def __init__(self, target_id, lock_root=None):
        safe_id(target_id, "target ID")
        self.target_id = target_id
        self.lock_root = Path(lock_root) if lock_root is not None else LOCK_ROOT
        self.path = self.lock_root / f"{target_id}.lock"
        self.fd = None
        self._windows_lock = False

    def __enter__(self):
        self.lock_root.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(self.lock_root, 0o700)
        if self.path.exists() and self.path.is_symlink():
            fail("lock path must not be a symlink")
        no_follow = getattr(os, "O_NOFOLLOW", 0)
        try:
            self.fd = os.open(str(self.path), os.O_CREAT | os.O_RDWR | no_follow, 0o600)
        except PermissionError:
            fail("deployment lock is already held")
        try:
            import fcntl
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except ImportError:
            import msvcrt
            os.write(self.fd, b"0")
            os.lseek(self.fd, 0, os.SEEK_SET)
            try:
                msvcrt.locking(self.fd, msvcrt.LK_NBLCK, 1)
            except OSError:
                os.close(self.fd)
                self.fd = None
                fail("staging deployment lock is already held")
            self._windows_lock = True
        os.ftruncate(self.fd, 0)
        os.write(self.fd, str(os.getpid()).encode())
        return self

    def __exit__(self, _exc_type, _exc, _tb):
        if self.fd is not None:
            if self._windows_lock:
                import msvcrt
                os.lseek(self.fd, 0, os.SEEK_SET)
                msvcrt.locking(self.fd, msvcrt.LK_UNLCK, 1)
            else:
                import fcntl
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


def compose_config(policy, extra_files=None):
