def container_for_service(policy, service):
    output = docker([
        "ps", "-aq",
        "--filter", f"label=com.docker.compose.project={policy['composeProject']}",
        "--filter", f"label=com.docker.compose.service={service}",
    ], capture=True)
    ids = [line for line in output.splitlines() if line.strip()]
    if len(ids) != 1:
        fail(f"expected exactly one container for service {service}, found {len(ids)}")
    return ids[0]


def inspect_container(container_id):
    return json.loads(docker(["inspect", container_id], capture=True))[0]


def previous_images(policy):
    images = {}
    for service in policy["builtServices"]:
        container = inspect_container(container_for_service(policy, service))
        images[service] = {
            "containerId": container["Id"],
            "imageId": container["Image"],
            "imageName": container.get("Config", {}).get("Image", ""),
            "restartPolicy": container.get("HostConfig", {}).get("RestartPolicy", {}).get("Name", ""),
            "networkMode": container.get("HostConfig", {}).get("NetworkMode", ""),
            "mounts": container.get("Mounts", []),
        }
    return images


def write_override(policy, images, build_contexts=None, disable_build=False, suffix=""):
    suffix_text = f"-{suffix}" if suffix else ""
    override = Path(policy["targetRoot"]) / ".central-cicd" / "compose-state" / f"override-{policy['releaseId']}{suffix_text}.yaml"
    lines = ["services:"]
    contexts = build_contexts or {}
    for service, image in images.items():
        safe_id(service, "service")
        lines.extend([f"  {service}:", f"    image: {json.dumps(image)}"])
        candidate = contexts.get(service)
        if candidate is not None:
            context_path = Path(candidate["context"])
            if not context_path.is_absolute() or context_path.is_symlink() or not context_path.is_dir():
                fail("candidate build context must be an absolute, non-symlink directory")
            lines.extend([
                "    build:",
                f"      context: {json.dumps(str(context_path))}",
                f"      dockerfile: {json.dumps(candidate['dockerfile'])}",
            ])
        elif disable_build:
            # Compose's reset tag removes the source build mapping during rollback.
            # A plain YAML null is rejected by current Compose versions.
            lines.append("    build: !reset null")
    override.write_text(chr(10).join(lines) + chr(10))
    os.chmod(override, 0o600)
    return str(override)

def prepare_cab_build_contexts(policy, release):
    """Validate CAB's verified release tree and create a runtime-only web image context."""
    if policy.get("targetId") != "cab-production" or policy.get("projectId") != "cab":
        fail("candidate artifact mapping is not yet approved for this compose target")

    release = Path(release)
    if release.is_symlink() or not release.is_dir():
        fail("candidate release directory is missing or unsafe")

    # Jenkins archives the payload under .central-cicd/release/.
    wrapper = release / ".central-cicd"
    nested = wrapper / "release"
    if wrapper.exists():
        if wrapper.is_symlink() or not wrapper.is_dir():
            fail("candidate artifact wrapper is unsafe")
        if nested.is_symlink() or not nested.is_dir():
            fail("candidate nested release directory is missing or unsafe")
        resolved_root = release.resolve(strict=True)
        resolved_nested = nested.resolve(strict=True)
        if resolved_root not in resolved_nested.parents:
            fail("candidate nested release escapes extraction root")
        release = resolved_nested

    frontend = release / "frontend"
    backend = release / "backend"
    required_files = [
        backend / "package.json",
        backend / "package-lock.json",
        backend / "Dockerfile",
        backend / "server.js",
        frontend / "build" / "index.html",
    ]
    for item in required_files:
        if item.is_symlink() or not item.is_file():
            fail(f"candidate artifact is missing a required file: {item.relative_to(release)}")

    for context in (frontend, backend):
        if context.is_symlink() or not context.is_dir():
            fail("candidate build context is unsafe")
        for item in context.rglob("*"):
            if item.is_symlink():
                fail(f"candidate build context contains a symlink: {item.relative_to(release)}")

    # The built frontend artifact does not include the source nginx.conf, so
    # generate this pinned runtime configuration in the verified release.
    nginx_lines = [
        "server {",
        "    listen 80;",
        "    server_name _;",
        "    root /usr/share/nginx/html;",
        "    index index.html;",
        "    client_max_body_size 20m;",
        "    location /api/ {",
        "        proxy_pass http://backend:3223;",
        "        proxy_set_header Host $host;",
        "        proxy_set_header X-Real-IP $http_x_real_ip;",
        "        proxy_set_header X-Forwarded-For $http_x_forwarded_for;",
        "        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;",
        "    }",
        "    location /static/ { expires 30d; try_files $uri =404; }",
        "    location / { try_files $uri $uri/ /index.html; }",
        "}",
    ]
    (frontend / "nginx.conf").write_text(chr(10).join(nginx_lines) + chr(10))

    dockerfile_lines = [
        "FROM nginx:1.27-alpine",
        "COPY nginx.conf /etc/nginx/conf.d/default.conf",
        "COPY build/ /usr/share/nginx/html/",
        "EXPOSE 80",
        "HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1",
    ]
    runtime_dockerfile = frontend / "Dockerfile.central-cicd"
    runtime_dockerfile.write_text(chr(10).join(dockerfile_lines) + chr(10))
    os.chmod(frontend / "nginx.conf", 0o644)
    os.chmod(runtime_dockerfile, 0o644)

    return {
        "web": {"context": str(frontend.resolve(strict=True)), "dockerfile": runtime_dockerfile.name},
        "backend": {"context": str(backend.resolve(strict=True)), "dockerfile": "Dockerfile"},
    }


def _required_release_path(release, relative, directory=False):
    candidate = release / relative
    if candidate.is_symlink():
        fail(f"candidate release contains a symlink: {relative}")
    if directory and not candidate.is_dir():
        fail(f"candidate artifact is missing a required directory: {relative}")
    if not directory and not candidate.is_file():
        fail(f"candidate artifact is missing a required file: {relative}")
    resolved = candidate.resolve(strict=True)
    if release not in resolved.parents:
        fail(f"candidate release path escapes extraction root: {relative}")
    return resolved


