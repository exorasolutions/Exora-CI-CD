        fail("Loomrun candidate lacks the approved forward-only Prisma migration policy")

    image = new_images.get("api")
    if not isinstance(image, str) or not re.fullmatch(r"loomrun-api:cicd-[a-f0-9]{12}-[1-9][0-9]*", image):
        fail("Loomrun candidate API image is invalid for Prisma migration")

    env_file = Path("/srv/apps/loomrun/.env")
    if env_file.is_symlink() or not env_file.is_file():
        fail("Loomrun runtime environment file is missing or unsafe")

    run([
        "docker", "run", "--rm",
        "--network", "loomrun_default",
        "--env-file", str(env_file),
        "--mount", f"type=bind,src={env_file},dst=/app/.env,readonly",
        image,
        "prisma", "migrate", "deploy", "--schema", "prisma/schema.prisma",
    ], timeout=1800)

def release_images(policy):
    return {
        service: f"{policy['composeProject']}-{service}:cicd-{policy['commitSha'][:12]}-{policy['deploymentId']}"
        for service in policy["builtServices"]
    }


def wait_services(policy, attempts=60):
    for service in policy["healthServices"]:
        container_id = container_for_service(policy, service)
        for _ in range(attempts):
            container = inspect_container(container_id)
            state = container.get("State", {})
            health = state.get("Health")
            if not isinstance(health, dict):
                fail(f"service is missing a required Docker healthcheck: {service}")
            status = health.get("Status")
            if status == "healthy":
                break
            if status == "unhealthy":
                fail(f"Docker healthcheck reports unhealthy: {service}")
            if not state.get("Running"):
                fail(f"service is not running while awaiting health: {service}")
            time.sleep(2)
        else:
            fail(f"service did not become healthy before timeout: {service}")

def deploy(policy_path):
    # Enforce the root-owned target gate inside the mutation function.
    _, policy = load_policy(policy_path)
    guard_live_mutation("deploy", policy["targetId"])

    with TargetLock(policy["targetId"]):
        state_file = state_path(policy)
        if state_file.exists():
            fail("deployment ID already has a state record")
        artifact = stage_artifact(policy)
        try:
            validate_artifact_copy(policy, artifact)
            validate_archive(artifact)
            compose_config(policy)
            release = extract_artifact(policy, artifact)
        finally:
            cleanup_staging(policy)

        state = None
        try:
            release_root = (Path(policy["targetRoot"]) / ".central-cicd" / "compose-releases").resolve(strict=True)
            resolved_release = Path(release).resolve(strict=True)
            if release_root not in resolved_release.parents:
                fail("candidate release is outside the approved release root")

            contexts = prepare_build_contexts(policy, resolved_release)
            old_images = previous_images(policy)
            new_images = release_images(policy)
            override = write_override(policy, new_images, build_contexts=contexts)
            compose_config(policy, [override])
            state = {
                "deploymentId": policy["deploymentId"],
                "releaseId": policy["releaseId"],
                "policyPath": str(Path(policy_path).resolve()),
                "releasePath": str(resolved_release),
                "overrideFile": override,
                "oldImages": old_images,
                "newImages": new_images,
                "activationStarted": False,
                "status": "prepared",
            }
            write_state(policy, state)

            # Build both candidates before replacing either running service.
            for service in compose_deployment_order(policy):
                run([*compose_args(policy, [override]), "build", service], cwd=policy["composeWorkingDir"], timeout=1800)

            if policy.get("targetId") == "loomrun-production":
                # A migration failure occurs before activation, so live images remain untouched.
                state["migration"] = {"policy": policy.get("migrationPolicy", "none"), "status": "starting"}
                write_state(policy, state)
                run_loomrun_prisma_migrations(policy, new_images)
                state["migration"]["status"] = "succeeded"
                write_state(policy, state)

            # Once activation begins, errors must use the locked rollback path.
            state["activationStarted"] = True
            write_state(policy, state)
            for service in compose_deployment_order(policy):
                run([*compose_args(policy, [override]), "up", "-d", "--no-deps", service], cwd=policy["composeWorkingDir"], timeout=900)

            wait_services(policy)
            state["status"] = "deployed"
            write_state(policy, state)
            print(f"compose deployment {policy['deploymentId']} completed")
        except Exception as deploy_error:
            if state is not None and state.get("activationStarted"):
                try:
                    rollback_locked(policy, automatic=True)
                except Exception as rollback_error:
                    fail(f"deployment failed ({deploy_error}); rollback also failed ({rollback_error})")
                fail(f"deployment failed; previous images restored: {deploy_error}")
            if state is not None:
                state["status"] = "failed_before_activation"
                state["error"] = str(deploy_error)
                write_state(policy, state)
            fail(f"deployment failed before activation; live services were not changed: {deploy_error}")

def rollback_locked(policy, automatic=False):
    state_file = state_path(policy)
    if not state_file.is_file() or state_file.is_symlink():
        fail("deployment state record not found")
    state = json.loads(state_file.read_text())
    if state.get("status") not in {"deployed", "prepared"}:
        fail("deployment state is not rollbackable")
    if state.get("status") == "prepared" and not state.get("activationStarted"):
        fail("deployment never began activation; no service rollback is required")

    old_images = {}
    report = {"services": {}}
    try:
        for service in policy["builtServices"]:
            value = state.get("oldImages", {}).get(service, {})
            image_id = value.get("imageId", "")
            if not image_id.startswith("sha256:"):
                fail(f"missing immutable previous image ID for {service}")
            recovery_ref = f"{policy['composeProject']}-{service}:recovery-{policy['deploymentId']}"
            run(["docker", "tag", image_id, recovery_ref], timeout=300)
            resolved = docker(["image", "inspect", recovery_ref, "--format", "{{.Id}}"], capture=True)
            if resolved != image_id:
                fail(f"recovery image reference does not resolve to previous image for {service}")
            old_images[service] = recovery_ref
            report["services"][service] = {"previousImageId": image_id, "recoveryRef": recovery_ref}

        override = write_override(policy, old_images, disable_build=True, suffix="rollback")
        compose_config(policy, [override])
        for service in compose_deployment_order(policy):
            run([*compose_args(policy, [override]), "up", "-d", "--no-deps", service], cwd=policy["composeWorkingDir"], timeout=900)
        wait_services(policy)
        state["status"] = "rolled_back"
        state["rollbackOverrideFile"] = override
        state["rollbackReport"] = report
        write_state(policy, state)
        print(f"compose deployment {policy['deploymentId']} rolled back")
    except Exception as error:
        state["rollbackFailure"] = {"error": str(error), **report}
        write_state(policy, state)
        if automatic:
            raise
        fail(f"rollback failed: {error}")


def rollback(policy_path, automatic=False):
    _, policy = load_policy(policy_path)
    guard_live_mutation("rollback", policy["targetId"])
    with TargetLock(policy["targetId"]):
        rollback_locked(policy, automatic=automatic)


def staging_deploy(policy_path):
    _, policy = validate_staging_policy(policy_path)
    target_root = Path(policy["targetRoot"])
    with TargetLock(policy["targetId"], policy["lockRoot"]):
        state_file = state_path(policy)
        if state_file.exists():
            fail("staging deployment ID already has a state record")
        artifact = stage_artifact_for_staging(policy)
        try:
            validate_artifact_copy(policy, artifact)
            validate_archive(artifact)
            release = extract_artifact(policy, artifact)
        finally:
            cleanup_staging_artifact(policy)

        state = None
        try:
            release_root = (target_root / ".central-cicd" / "compose-releases").resolve(strict=True)
            resolved_release = Path(release).resolve(strict=True)
            if release_root not in resolved_release.parents:
                fail("staging candidate release is outside the approved release root")
            contexts = prepare_build_contexts(policy, resolved_release)
            old_images = previous_images(policy)
            new_images = release_images(policy)
            override = write_override(policy, new_images, build_contexts=contexts)
            compose_config(policy, [override])
            state = {
                "deploymentId": policy["deploymentId"],
                "releaseId": policy["releaseId"],
                "policyPath": str(Path(policy_path).resolve()),
                "releasePath": str(resolved_release),
                "overrideFile": override,
                "oldImages": old_images,
                "newImages": new_images,
                "activationStarted": False,
                "status": "prepared",
            }
            write_state(policy, state)
            for service in compose_deployment_order(policy):
                run([*compose_args(policy, [override]), "build", service], cwd=policy["composeWorkingDir"], timeout=1800)
            state["activationStarted"] = True
            write_state(policy, state)
            for service in compose_deployment_order(policy):
                run([*compose_args(policy, [override]), "up", "-d", "--no-deps", service], cwd=policy["composeWorkingDir"], timeout=900)
            wait_services(policy)
            state["status"] = "deployed"
            write_state(policy, state)
            print(json.dumps({"status": "deployed", "oldImages": old_images, "newImages": new_images}, sort_keys=True))
        except Exception as deploy_error:
            if state is not None and state.get("activationStarted"):
                try:
                    rollback_locked(policy, automatic=True)
                except Exception as rollback_error:
                    fail(f"staging deployment failed ({deploy_error}); rollback also failed ({rollback_error})")
                fail(f"staging deployment failed; previous images restored: {deploy_error}")
            if state is not None:
                state["status"] = "failed_before_activation"
                state["error"] = str(deploy_error)
                write_state(policy, state)
            fail(f"staging deployment failed before activation; no services were changed: {deploy_error}")


def staging_rollback(policy_path):
    _, policy = validate_staging_policy(policy_path)
    with TargetLock(policy["targetId"], policy["lockRoot"]):
        rollback_locked(policy)


def staging_cleanup(policy_path):
    _, policy = validate_staging_policy(policy_path)
    target_root = Path(policy["targetRoot"])
    marker = Path(policy["stagingMarker"])
    try:
        marker_data = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        fail("staging ownership marker is invalid")
    if marker_data.get("targetId") != policy["targetId"] or marker_data.get("deploymentId") != policy["deploymentId"]:
        fail("staging ownership marker does not match the policy")
    compose_config(policy)
    run([*compose_args(policy), "down", "--volumes", "--remove-orphans"], cwd=policy["composeWorkingDir"], timeout=300)
    image_refs = docker(["images", "--format", "{{.Repository}}:{{.Tag}}"], capture=True).splitlines()
    prefix = f"{policy['composeProject']}-"
    for image_ref in image_refs:
        if image_ref.startswith(prefix):
            run(["docker", "image", "rm", image_ref], timeout=300)
    if target_root.exists() and not target_root.is_symlink():
        shutil.rmtree(target_root)
    print(f"staging cleanup completed for {policy['targetId']}")

def validate_only(policy_path):
    _, policy = load_policy(policy_path)
    with TargetLock(policy["targetId"]):
        artifact = stage_artifact(policy)
        try:
            validate_artifact_copy(policy, artifact)
            validate_archive(artifact)
            compose_config(policy)
            for service in policy["builtServices"]:
                container_for_service(policy, service)
        finally:
            cleanup_staging(policy)
    print("PASS: compose policy, artifact, and current service selection validated.")


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in {"validate", "deploy", "rollback", "stage-deploy", "stage-rollback", "stage-cleanup"}:
        fail("usage: central-compose-deploy validate|deploy|rollback|stage-deploy|stage-rollback|stage-cleanup POLICY_JSON")
    command, policy_path = sys.argv[1], sys.argv[2]
    if command == "validate":
        validate_only(policy_path)
    elif command == "deploy":
        guard_live_mutation(command)
        deploy(policy_path)
    elif command == "rollback":
        guard_live_mutation(command)
        rollback(policy_path)
    elif command == "stage-deploy":
        staging_deploy(policy_path)
    elif command == "stage-rollback":
        staging_rollback(policy_path)
    else:
        staging_cleanup(policy_path)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"central-compose-deploy: {exc}", file=sys.stderr)
        sys.exit(1)
