def fail(message):
    raise RuntimeError(message)


def approved_live_targets():
    # Fail closed: absent configuration means no live mutation is authorized.
    config_dir = LIVE_TARGETS_CONFIG.parent
    try:
        dir_info = config_dir.lstat()
    except FileNotFoundError:
        return set()
    except OSError:
        fail("cannot inspect root-owned live-target configuration directory")

    if (stat.S_ISLNK(dir_info.st_mode) or
            not stat.S_ISDIR(dir_info.st_mode) or
            dir_info.st_uid != 0 or
            (stat.S_IMODE(dir_info.st_mode) & 0o022)):
        fail("live-target configuration directory must be a root-owned, non-writable-by-others directory")

    try:
        info = LIVE_TARGETS_CONFIG.lstat()
    except FileNotFoundError:
        return set()
    except OSError:
        fail("cannot inspect live-target configuration")

    if (stat.S_ISLNK(info.st_mode) or
            not stat.S_ISREG(info.st_mode) or
            info.st_uid != 0 or
            stat.S_IMODE(info.st_mode) != 0o600):
        fail("live-target configuration must be a root-owned regular file with mode 0600")

    try:
        lines = LIVE_TARGETS_CONFIG.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        fail("cannot read live-target configuration")

    enabled = set()
    for line_number, raw in enumerate(lines, 1):
        value = raw.strip()
        if not value or value.startswith("#"):
            continue
        if value not in LIVE_MUTATION_TARGETS:
            fail(f"live-target configuration contains an unauthorized target on line {line_number}")
        enabled.add(value)
    return enabled


def guard_live_mutation(command, target_id=None):
    # Reject targets outside the permitted deployment scope.
    if target_id is not None and target_id not in LIVE_MUTATION_TARGETS:
        fail(f"live compose {command} is not permitted for target {target_id}")

    approved = approved_live_targets()
    if not approved:
        if command == "deploy":
            # Safety invariant: live compose deployment blocked pending verified candidate build-context mapping.
            fail("live compose deploy blocked pending verified candidate build-context mapping and health contracts")
        fail(f"live compose {command} blocked pending verified candidate build-context mapping and health contracts")

    # The dispatcher checks the gate before loading a policy. The mutation
    # functions check the actual target again after the policy is loaded.
    if target_id is None:
        return
    if target_id not in approved:
        fail(f"live compose {command} blocked; target {target_id} is not enabled in {LIVE_TARGETS_CONFIG}")


def run(args, cwd=None, capture=False, timeout=900):
    result = subprocess.run(
        args,
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        timeout=timeout,
    )
    if result.returncode != 0:
        detail = (result.stderr or "").strip() if capture else ""
        fail(f"{args[0]} failed" + (f": {detail}" if detail else ""))
    return result.stdout.strip() if capture else ""


def docker(args, capture=False):
    return run(["docker", *args], capture=capture)


def compose_args(policy, extra_files=None):
    args = ["docker", "compose", "-p", policy["composeProject"]]
    for file_name in [*policy["composeFiles"], *(extra_files or [])]:
        args.extend(["-f", file_name])
    return args


def safe_id(value, label):
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", value):
        fail(f"invalid {label}")


def validate_policy_path(path_string):
    original = Path(path_string)
    if not original.is_absolute() or original.is_symlink():
        fail("policy must be an absolute, non-symlink path")
    root = WORK_ROOT.resolve(strict=True)
    policy_path = original.resolve(strict=True)
    if root not in policy_path.parents:
        fail("policy is outside /opt/cicd/work")
    if not policy_path.is_file():
        fail("policy is not a regular file")
    stat = policy_path.stat()
    try:
        worker_uid = pwd.getpwnam("prasad").pw_uid if pwd is not None else -1
    except KeyError:
        worker_uid = -1
    current_uid = getattr(os, "getuid", lambda: -1)()
    if stat.st_uid not in {0, current_uid, worker_uid}:
        fail("policy owner is not approved")
    if stat.st_mode & 0o077:
        fail("policy file must not be accessible by group or other users")
    return policy_path


def load_policy(path_string):
    policy_path = validate_policy_path(path_string)
    policy = json.loads(policy_path.read_text())
    if policy.get("schemaVersion") != 1:
        fail("unsupported compose policy schema")
    for key in [
        "deploymentId", "releaseId", "projectId", "targetId", "environment",
        "commitSha", "artifactPath", "artifactSha256", "targetRoot",
        "composeProject", "composeWorkingDir", "composeFiles", "composeServices",
        "builtServices", "healthServices", "containers", "persistentMounts",
        "publicBindings", "preservePolicy", "deploymentStatus", "composeHealthPolicy"
    ]:
        if key not in policy:
            fail(f"compose policy missing {key}")
    safe_id(policy["deploymentId"], "deployment ID")
    safe_id(policy["releaseId"], "release ID")
    safe_id(policy["composeProject"], "compose project")
    if policy["environment"] != "production":
        fail("compose helper only supports production policies")
    if not re.fullmatch(r"[a-f0-9]{40}", policy["commitSha"]):
        fail("invalid commit SHA")
    if not re.fullmatch(r"[a-f0-9]{64}", policy["artifactSha256"]):
        fail("invalid artifact SHA-256")
    for key in ["composeFiles", "composeServices", "builtServices", "healthServices"]:
        if not isinstance(policy[key], list) or not policy[key]:
            fail(f"compose policy {key} must be a non-empty list")
    for service in policy["composeServices"]:
        safe_id(service, "compose service")
    for service in [*policy["builtServices"], *policy["healthServices"]]:
        if service not in policy["composeServices"]:
            fail(f"service is not approved for this target: {service}")
    validate_approved_contract(policy)
    target_root = Path(policy["targetRoot"])
    workdir = Path(policy["composeWorkingDir"])
    if not target_root.is_absolute() or not workdir.is_absolute():
        fail("target root and compose workdir must be absolute")
    if target_root.resolve(strict=False) not in [workdir.resolve(strict=False), *workdir.resolve(strict=False).parents]:
        fail("compose workdir is outside target root")
    for file_name in policy["composeFiles"]:
        file_path = Path(file_name)
        if not file_path.is_absolute():
            fail("compose file must be absolute")
        if target_root.resolve(strict=False) not in [file_path.resolve(strict=False), *file_path.resolve(strict=False).parents]:
            fail("compose file is outside target root")
    return policy_path, policy


def validate_approved_contract(policy):
    expected = APPROVED_TARGETS.get(policy.get("targetId"))
    if not expected:
        fail("unknown compose target")
    for key in [
        "projectId", "targetRoot", "composeProject", "composeWorkingDir",
        "composeFiles", "composeServices", "builtServices", "healthServices",
        "containers", "persistentMounts", "publicBindings", "preservePolicy"
    ]:
        if policy.get(key) != expected.get(key):
            fail(f"compose policy violates approved contract: {key}")
    for key in ["networks", "internalPorts", "networkMode", "sharedDeploymentPolicy"]:
        if policy.get(key, "") != expected.get(key, ""):
            fail(f"compose policy violates approved contract: {key}")
    for key in ["candidateContextPolicy", "healthContract", "migrationPolicy", "identityIsolationPolicy"]:
        if key in expected and policy.get(key) != expected[key]:
            fail(f"compose policy violates approved contract: {key}")
    if policy.get("deploymentStatus") != "compose-helper-installed-and-staging-validated":
        if not (policy.get("dryRun") is True and policy.get("targetId") == "exora-health-platform-production" and policy.get("deploymentStatus") == "dry-run-only-compose-helper-validation"):
            fail("compose target is not approved for live helper execution")
    if policy.get("composeHealthPolicy") != "docker-healthcheck-required":
        fail("compose target lacks approved docker health-check policy")


def state_dir(policy):
    path = Path(policy["targetRoot"]) / ".central-cicd" / "compose-state"
    if path.exists() and path.is_symlink():
        fail("compose state directory must not be a symlink")
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def state_path(policy):
    return state_dir(policy) / f"deployment-{policy['deploymentId']}.json"


def write_state(policy, value):
    directory = state_dir(policy)
    fd, tmp = tempfile.mkstemp(prefix=".state-", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as stream:
            json.dump(value, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, state_path(policy))
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def stage_artifact(policy):
    original = Path(policy["artifactPath"])
    if not original.is_absolute() or original.is_symlink():
        fail("artifact must be an absolute, non-symlink path")
    root = ARTIFACT_ROOT.resolve(strict=True)
    artifact = original.resolve(strict=True)
    if root not in artifact.parents:
        fail("artifact is outside /opt/cicd/artifacts")
    if not artifact.is_file():
        fail("artifact is not a regular file")
    staging_root = STAGING_ROOT / policy["targetId"] / policy["deploymentId"]
    if staging_root.exists() and staging_root.is_symlink():
        fail("artifact staging directory must not be a symlink")
    staging_root.mkdir(mode=0o700, parents=True, exist_ok=False)
    os.chmod(staging_root, 0o700)
    staged = staging_root / "artifact.tar.gz"
    with artifact.open("rb") as source, staged.open("xb") as dest:
        shutil.copyfileobj(source, dest, length=1024 * 1024)
    os.chmod(staged, 0o600)
    return staged


def staging_root_from_environment():
    value = os.environ.get(STAGING_ROOT_ENV, "").strip()
    if not value:
        fail(f"{STAGING_ROOT_ENV} is required for staging commands")
    root = Path(value)
    if not root.is_absolute() or root.resolve(strict=False) == Path(root.anchor).resolve():
        fail("staging root must be a non-root absolute path")
    return root.resolve(strict=False)


def validate_staging_policy(policy_path):
    path = Path(policy_path)
    if not path.is_absolute() or path.is_symlink() or not path.is_file():
        fail("staging policy must be an absolute, regular, non-symlink file")
    designated_root = staging_root_from_environment()
    resolved_policy = path.resolve(strict=True)
    if designated_root not in resolved_policy.parents:
        fail("staging policy is outside the designated staging root")
    try:
        policy = json.loads(resolved_policy.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        fail("staging policy is not valid JSON")

    required = [
        "schemaVersion", "deploymentId", "releaseId", "projectId", "targetId",
        "environment", "commitSha", "artifactPath", "artifactSha256", "targetRoot",
        "composeProject", "composeWorkingDir", "composeFiles", "composeServices",
        "builtServices", "healthServices", "containers", "persistentMounts",
        "publicBindings", "preservePolicy", "candidateContextPolicy", "healthContract",
        "stagingRoot", "lockRoot", "stagingNetwork", "stagingVolumes", "stagingMarker",
    ]
    for key in required:
        if key not in policy:
            fail(f"staging policy missing {key}")
    if policy["schemaVersion"] != 1 or policy["environment"] != "staging":
        fail("staging policy must explicitly use environment=staging")
    if policy["projectId"] != "loomrun":
        fail("staging mode only supports project loomrun")
    if not re.fullmatch(r"loomrun-staging-[A-Za-z0-9_.-]{1,100}", policy["targetId"]):
        fail("invalid Loomrun staging target ID")
    if not re.fullmatch(r"loomrun-staging-[A-Za-z0-9_.-]{1,100}", policy["composeProject"]):
        fail("invalid Loomrun staging Compose project")
    if policy["targetId"] in LIVE_MUTATION_TARGETS or policy["targetId"] in APPROVED_TARGETS:
        fail("staging policy cannot use a production target ID")
    safe_id(policy["deploymentId"], "deployment ID")
    safe_id(policy["releaseId"], "release ID")
    if not re.fullmatch(r"[a-f0-9]{40}", policy["commitSha"]):
        fail("invalid staging commit SHA")
    if not re.fullmatch(r"[a-f0-9]{64}", policy["artifactSha256"]):
        fail("invalid staging artifact SHA-256")
    if policy["stagingRoot"] != policy["targetRoot"]:
        fail("stagingRoot and targetRoot must be identical")
    target_root = Path(policy["targetRoot"]).resolve(strict=False)
    if designated_root not in target_root.parents or target_root == designated_root:
        fail("staging target root must be a child of the designated staging root")
    if str(target_root) in PRODUCTION_ROOTS or any(root in target_root.parents for root in PRODUCTION_ROOTS):
        fail("staging target root overlaps a production root")
    working_dir = Path(policy["composeWorkingDir"]).resolve(strict=False)
    if working_dir != target_root:
        fail("staging Compose working directory must equal staging target root")
    if policy["candidateContextPolicy"] != "loomrun-source-root-v1":
        fail("staging policy lacks the approved Loomrun context policy")
    if policy["healthContract"] != "loomrun-web-root-api-ready-v1":
        fail("staging policy lacks the approved Loomrun health contract")
    if policy["composeServices"] != ["web", "api", "redis", "postgres"]:
        fail("staging services must be the explicit Loomrun disposable service set")
    if policy["builtServices"] != ["api", "web"] or policy["healthServices"] != ["api", "web"]:
        fail("staging build and health service order is not approved")
    for service in policy["composeServices"]:
        safe_id(service, "compose service")
    for key in ["stagingNetwork", "lockRoot"]:
        value = Path(policy[key]).resolve(strict=False) if key == "lockRoot" else policy[key]
        if key == "lockRoot" and (value != target_root / ".central-cicd" / "locks"):
            fail("staging lock root must be inside the staging root")
        if key == "stagingNetwork" and not re.fullmatch(r"loomrun-staging-[A-Za-z0-9_.-]{1,100}", value):
            fail("invalid staging network name")
    if not isinstance(policy["stagingVolumes"], list) or not policy["stagingVolumes"]:
        fail("staging volumes must be an explicit non-empty list")
    for volume in policy["stagingVolumes"]:
        safe_id(volume, "staging volume")
        if not volume.startswith("loomrun-staging-"):
            fail("staging volume is not uniquely namespaced")
    marker = Path(policy["stagingMarker"])
    if marker != target_root / ".central-cicd" / "staging-marker.json" or marker.is_symlink():
        fail("invalid staging ownership marker")
    if not marker.is_file():
        fail("staging ownership marker is missing")
    for file_name in policy["composeFiles"]:
        file_path = Path(file_name).resolve(strict=False)
        if target_root not in file_path.parents or not file_path.is_file():
            fail("staging Compose file is outside the staging root or missing")
        if str(file_path) in PRODUCTION_ROOTS:
            fail("staging Compose file overlaps a production path")
        try:
            compose_text = file_path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            fail("cannot read staging Compose file")
        normalized_compose = compose_text.replace("\\", "/")
        for production_root in PRODUCTION_ROOTS:
            if production_root in normalized_compose:
                fail("staging Compose file references a production root")
        if re.search(r"(?im)^\s*external\s*:\s*true\s*$", compose_text):
            fail("staging Compose file cannot use an external network")
        if policy["stagingNetwork"] not in compose_text:
            fail("staging Compose file does not declare the approved staging network")
        for volume in policy["stagingVolumes"]:
            if volume not in compose_text:
                fail("staging Compose file does not declare every approved staging volume")
        if "staging.env" not in normalized_compose:
            fail("staging Compose file must use the disposable staging environment file")
    artifact = Path(policy["artifactPath"]).resolve(strict=False)
    if target_root not in artifact.parents or artifact.is_symlink() or not artifact.is_file():
        fail("staging artifact must be a regular file inside the staging root")
    return resolved_policy, policy


def validate_artifact_copy(policy, artifact):
    digest = hashlib.sha256()
    with artifact.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    if digest.hexdigest().lower() != policy["artifactSha256"].lower():
        fail("artifact SHA-256 mismatch")
    return artifact


def stage_artifact_for_staging(policy):
    original = Path(policy["artifactPath"]).resolve(strict=True)
    target_root = Path(policy["targetRoot"]).resolve(strict=True)
    if target_root not in original.parents or original.is_symlink() or not original.is_file():
        fail("staging artifact is outside the staging root")
    staging_root = target_root / ".central-cicd" / "staging-artifacts" / policy["deploymentId"]
    if staging_root.exists():
        if staging_root.is_symlink():
            fail("staging artifact directory must not be a symlink")
        fail("staging artifact directory already exists")
    staging_root.mkdir(mode=0o700, parents=True)
    os.chmod(staging_root, 0o700)
    staged = staging_root / "artifact.tar.gz"
    with original.open("rb") as source, staged.open("xb") as destination:
        shutil.copyfileobj(source, destination, length=1024 * 1024)
    os.chmod(staged, 0o600)
    return staged


def validate_archive(artifact):
    total = 0
    with tarfile.open(artifact, "r:gz") as archive:
        members = archive.getmembers()
        if not members or len(members) > MAX_FILES:
            fail("archive is empty or contains too many entries")
        seen = set()
        for member in members:
            raw = member.name
            if not raw or raw.startswith("/") or "\\" in raw:
                fail(f"unsafe archive path: {raw!r}")
            parts = PurePosixPath(raw).parts
            if not parts or ".." in parts or "\x00" in raw:
                fail(f"unsafe archive path: {raw!r}")
            normal = "/".join(parts)
            if normal in seen:
                fail(f"duplicate archive entry: {normal}")
            seen.add(normal)
            if not (member.isdir() or member.isfile()):
                fail(f"unsupported archive entry type: {normal}")
            if member.isfile():
                total += member.size
                if total > MAX_BYTES:
                    fail("artifact exceeds size limit")


def extract_artifact(policy, artifact):
    releases = Path(policy["targetRoot"]) / ".central-cicd" / "compose-releases"
    if releases.exists() and releases.is_symlink():
        fail("compose release directory must not be a symlink")
    releases.mkdir(mode=0o700, parents=True, exist_ok=True)
    release = releases / policy["releaseId"]
    if release.exists():
        fail("release directory already exists")
    release.mkdir(mode=0o700)
    with tarfile.open(artifact, "r:gz") as archive:
        for member in archive.getmembers():
            destination = (release / member.name).resolve(strict=False)
            if release.resolve(strict=True) not in [destination, *destination.parents]:
                fail(f"archive entry escapes release directory: {member.name}")
        archive.extractall(release)
    return release


