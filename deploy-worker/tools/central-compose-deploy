def _unwrap_release(release, component=None):
    release = Path(release)
    if release.is_symlink() or not release.is_dir():
        fail("candidate release directory is missing or unsafe")
    release = release.resolve(strict=True)
    wrapper = release / ".central-cicd" / "release"
    nested = wrapper / component if component else wrapper
    if (release / ".central-cicd").exists():
        if wrapper.is_symlink() or not wrapper.is_dir() or nested.is_symlink() or not nested.is_dir():
            fail("candidate artifact wrapper is unsafe")
        nested = nested.resolve(strict=True)
        if release not in nested.parents:
            fail("candidate nested release escapes extraction root")
        return nested
    return release

